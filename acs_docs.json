    }
  },

  "panel_controls": [
    "CREATE_VIEW",
    "CREATE_SECTION",
    "CREATE_ELEVATION",
    "GENERATE_SCHEDULE",
    "GENERATE_QUANTITIES",
    "COMPOSE_SHEET",
    "ADD_VIEWPORT",
    "REMOVE_VIEWPORT",
    "MOVE_VIEWPORT",
    "SET_SHEET_METADATA",
    "REGENERATE",
    "EXPORT",
    "PREVIEW"
  ],
  "panel_forbidden_controls": [
    "MOVE_WALL",
    "MOVE_DOOR",
    "RESIZE_SPACE",
    "DELETE_SPACE",
    "ADD_WALL",
    "EDIT_MODEL",
    "AUTO_FIX_CLASH",
    "AUTO_ROUTE_MEP",
    "SET_FIRE_RATING",
    "APPROVE_DRAWING"
  ],

  "safe_id_pattern": "^[A-Za-z0-9._:@$\\-]{1,128}$",
  "safe_filename_pattern": "^[A-Za-z0-9][A-Za-z0-9._\\-]{0,119}$",
  "unsafe_patterns": [
    "javascript:",
    "data:text/html",
    "<script",
    "</script",
    "<img",
    "<iframe",
    "<svg",
    "<object",
    "<embed",
    "onerror=",
    "onload=",
    "onclick=",
    "eval(",
    "new Function",
    "vbscript:",
    "<!ENTITY",
    "<!DOCTYPE",
    "file://",
    "\\u0000",
    "../",
    "..\\"
  ],
  "forbidden_property_keys": [
    "__proto__",
    "constructor",
    "prototype",
    "__defineGetter__",
    "__defineSetter__",
    "__lookupGetter__",
    "__lookupSetter__"
  ],
  "path_traversal_patterns": ["../", "..\\", "/", "\\", ":", "\u0000"],
  "reserved_filenames": ["CON", "PRN", "AUX", "NUL", "COM1", "COM2", "LPT1", "LPT2", "."],
  "export_directory_escape_allowed": false,

  "limits": {
    "max_views_per_document": 512,
    "max_sheets_per_document": 512,
    "max_viewports_per_sheet": 24,
    "max_schedule_rows": 20000,
    "max_annotation_length": 2048,
    "max_note_length": 4096,
    "max_notes_per_sheet": 64,
    "max_dimensions_per_view": 4000,
    "max_annotations_per_view": 4000,
    "max_svg_bytes": 33554432,
    "max_pdf_bytes": 67108864,
    "max_filename_length": 120,
    "max_export_files": 512,
    "max_coordinate_m": 100000,
