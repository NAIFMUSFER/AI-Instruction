{
  "schema": "acs.docs/1",
  "version": "1.0.0",
  "compiler_version": "acs-docs/1.0.0",
  "documentation_spec_version": "acs.docs/1.0.0",

  "documentation_is_read_only": true,
  "writes_to_model": false,
  "reverse_write_allowed": false,
  "mutates_engineering_model": false,
  "model_hash_inputs": ["model"],
  "authority_note": "documentation reports what the canonical model contains. It never invents engineering information to make a drawing look complete, and it never writes back. An edit reaches the model only through the phase 5 authoring path.",

  "pipeline": [
    "CANONICAL_MODEL",
    "DISCIPLINE_COMPILERS",
    "DOCUMENTATION_COMPILER",
    "VIEW_DEFINITION",
    "DRAWING_GEOMETRY",
    "ANNOTATION",
    "SHEET_COMPOSITION",
    "EXPORT"
  ],

  "view_types": [
    "FLOOR_PLAN",
    "CEILING_PLAN",
    "SITE_PLAN",
    "ROOF_PLAN",
    "ELEVATION",
    "SECTION",
    "DETAIL",
    "STRUCTURAL_PLAN",
    "MEP_PLAN",
    "FLS_PLAN",
    "COORDINATION_PLAN",
    "THREE_D_REFERENCE"
  ],
  "view_support": [
    {"view_type": "FLOOR_PLAN", "support": "SUPPORTED", "basis": "architectural walls, openings, spaces, slabs, voids and cores"},
    {"view_type": "ELEVATION", "support": "SUPPORTED", "basis": "exterior wall extents and represented openings projected onto a vertical plane"},
    {"view_type": "SECTION", "support": "SUPPORTED", "basis": "mathematical intersection of a vertical plane with model geometry"},
    {"view_type": "SITE_PLAN", "support": "SUPPORTED", "basis": "site extent and building footprint where both are represented"},
    {"view_type": "STRUCTURAL_PLAN", "support": "SUPPORTED", "basis": "represented columns, beams, structural slabs, foundations and grids"},
    {"view_type": "MEP_PLAN", "support": "SUPPORTED", "basis": "represented equipment, terminals, segments, risers and penetrations"},
    {"view_type": "FLS_PLAN", "support": "SUPPORTED", "basis": "represented devices, signs, exits, barriers and zones"},
    {"view_type": "COORDINATION_PLAN", "support": "SUPPORTED", "basis": "existing clash findings shown as annotations only"},
    {"view_type": "DETAIL", "support": "SUPPORTED", "basis": "a magnified crop of an existing view; no assembly is invented"},
    {"view_type": "ROOF_PLAN", "support": "PARTIALLY_SUPPORTED", "basis": "roof outline where represented; no roof build-up, falls or drainage"},
    {"view_type": "CEILING_PLAN", "support": "PARTIALLY_SUPPORTED", "basis": "ceiling extents where represented; no grid layout is invented"},
    {"view_type": "THREE_D_REFERENCE", "support": "NOT_SUPPORTED", "basis": "requires a raster or WebGL pipeline that this documentation layer does not own"}
  ],
  "view_support_states": [
    "SUPPORTED",
    "PARTIALLY_SUPPORTED",
    "NOT_SUPPORTED",
    "INSUFFICIENT_DATA",
    "STALE"
  ],
  "view_fields": [
    "view_id",
    "view_type",
    "building_id",
    "level_id",
    "discipline",
    "orientation",
    "cut_plane",
    "view_depth",
    "crop_region",
    "scale",
    "visible_categories",
    "hidden_categories",
    "annotation_policy",
    "dimension_policy",
    "source_model_hash",
    "status"
  ],

  "disciplines": [
    "ARCHITECTURE",
    "STRUCTURE",
    "MECHANICAL",
    "ELECTRICAL",
    "PLUMBING",
    "FIRE_PROTECTION",
    "ICT",
    "COORDINATION"
  ],
  "mep_disciplines": ["MECHANICAL", "ELECTRICAL", "PLUMBING", "FIRE_PROTECTION", "ICT"],
  "orientations": ["NORTH", "SOUTH", "EAST", "WEST"],
  "orientation_note": "an elevation direction is geometric. No facade is called the front unless the model states an orientation; a building rotation is applied to the projection, never ignored.",

  "categories": [
    "WALL",
    "DOOR",
    "WINDOW",
    "OPENING",
    "SPACE",
    "SLAB",
    "VOID",
    "CORE",
    "STAIR",
    "COLUMN",
    "BEAM",
    "STRUCTURAL_SLAB",
    "FOUNDATION",
    "GRID",
    "MEP_EQUIPMENT",
    "MEP_TERMINAL",
    "MEP_SEGMENT",
    "MEP_RISER",
    "MEP_PENETRATION",
    "FLS_DEVICE",
    "FLS_SIGN",
    "FLS_EXIT",
    "FLS_BARRIER",
    "CLASH"
  ],
  "discipline_categories": {
    "ARCHITECTURE": ["WALL", "DOOR", "WINDOW", "OPENING", "SPACE", "SLAB", "VOID", "CORE", "STAIR"],
    "STRUCTURE": ["COLUMN", "BEAM", "STRUCTURAL_SLAB", "FOUNDATION", "GRID", "WALL", "SPACE"],
    "MECHANICAL": ["MEP_EQUIPMENT", "MEP_TERMINAL", "MEP_SEGMENT", "MEP_RISER", "MEP_PENETRATION", "WALL", "SPACE"],
    "ELECTRICAL": ["MEP_EQUIPMENT", "MEP_TERMINAL", "MEP_SEGMENT", "MEP_RISER", "WALL", "SPACE"],
    "PLUMBING": ["MEP_EQUIPMENT", "MEP_TERMINAL", "MEP_SEGMENT", "MEP_RISER", "WALL", "SPACE"],
    "FIRE_PROTECTION": ["FLS_DEVICE", "FLS_SIGN", "FLS_EXIT", "FLS_BARRIER", "WALL", "SPACE", "DOOR"],
    "ICT": ["MEP_EQUIPMENT", "MEP_TERMINAL", "MEP_SEGMENT", "WALL", "SPACE"],
    "COORDINATION": ["CLASH", "WALL", "SPACE", "COLUMN", "BEAM", "MEP_SEGMENT", "MEP_EQUIPMENT"]
  },

  "geometry_classes": ["CUT", "PROJECTED", "BEYOND_DEPTH", "UNRESOLVED"],
  "geometry_class_note": "an element is cut when the view plane intersects it, projected when it lies within the view depth, beyond when it falls outside that depth, and unresolved when its geometry is not represented well enough to classify.",

  "value_policy": "MODEL_STATED_ONLY",
  "value_policy_note": "the canonical layers carry a value together with its source and a separate render_fallback. Documentation reads the stated value only. A null value is reported UNKNOWN. A render fallback is a display convenience and is never promoted to a documented dimension, a schedule cell or a quantity.",
  "value_states": ["STATED", "DERIVED", "UNKNOWN"],
  "unknown_display": "NOT_SPECIFIED",

  "dimension_types": [
    "OVERALL_BUILDING",
    "OVERALL_LEVEL",
    "SPACE_WIDTH",
    "SPACE_DEPTH",
    "WALL_SEGMENT_LENGTH",
    "OPENING_WIDTH",
    "OPENING_HEIGHT",
    "GRID_SPACING",
    "COLUMN_SPACING",
    "LEVEL_ELEVATION",
    "DETAIL_MEASURE"
  ],
  "dimension_fields": [
    "dimension_id",
    "measurement_type",
    "source_element_ids",
    "exact_value",
    "display_value",
    "unit",
    "precision",
    "provenance",
    "measurement_status"
  ],
  "dimension_provenance": ["MODEL_GEOMETRY", "MODEL_STATED_VALUE", "DERIVED_FROM_GEOMETRY"],
  "measurement_statuses": ["MEASURED", "UNKNOWN", "UNRESOLVED"],
  "dimension_precision_m": 3,
  "dimension_note": "display rounding never modifies exact_value. A dimension whose underlying value is unknown is emitted with measurement_status UNKNOWN and no display value — a render fallback never becomes a dimension.",
  "dimension_chain_policy": "DECLARED_ONLY",
  "dimension_chain_levels": ["OVERALL", "MAJOR_PARTITION", "OPENING"],
  "dimension_policies": ["NONE", "OVERALL_ONLY", "OVERALL_AND_SPACES", "FULL_CHAIN"],

  "level_datum_types": ["LEVEL_ELEVATION"],
  "level_datum_note": "only the architectural level elevation is documented. FFL, SSL, TOS and TOC are not emitted because no corresponding semantic datum exists in the canonical model.",
  "forbidden_datum_labels": ["FFL", "SSL", "TOS", "TOC", "SFL"],

  "grid_policy": "REPRESENTED_ONLY",
  "grid_note": "grid lines, bubbles and spacings are drawn only from represented structural grids. No grid is generated because a drawing convention expects one.",

  "annotation_types": [
    "ROOM_TAG",
    "DOOR_TAG",
    "WINDOW_TAG",
    "EQUIPMENT_TAG",
    "LEVEL_TAG",
    "GRID_TAG",
    "SECTION_MARK",
    "ELEVATION_MARK",
    "DETAIL_MARK",
    "CLASH_MARK",
    "GENERAL_NOTE",
    "MODEL_NOTE"
  ],
  "annotation_provenance": [
    "MODEL_DERIVED",
    "USER_AUTHORED",
    "SYSTEM_LABEL",
    "DOCUMENTATION_DERIVED"
  ],
  "annotation_provenance_note": "generated text is never presented as user-authored text. A user note lives in documentation state and never changes architectural, structural, MEP or FLS semantics.",
  "annotation_policies": ["NONE", "TAGS_ONLY", "TAGS_AND_NOTES", "FULL"],
  "annotation_fields": [
    "annotation_id",
    "annotation_type",
    "provenance",
    "text",
    "source_element_ids",
    "x",
    "y",
    "view_id"
  ],

  "text_only_fields": ["text", "name", "title", "description", "note", "label", "sheet_name"],
  "inert_text_note": "every model label and user note is inert text. It is never an object key, never a canonical field name and never markup. A label that resembles a prototype key or a template expression is carried as text rather than refused, because a real project may legitimately contain it; it is written to the document escaped, and it can never create a field.",

  "schedule_types": [
    "ROOM_SCHEDULE",
    "DOOR_SCHEDULE",
    "WINDOW_SCHEDULE",
    "EQUIPMENT_SCHEDULE",
    "COLUMN_SCHEDULE",
    "BEAM_SCHEDULE",
    "SLAB_SCHEDULE",
    "FOUNDATION_SCHEDULE",
    "MEP_EQUIPMENT_SCHEDULE",
    "MEP_TERMINAL_SCHEDULE",
    "FLS_DEVICE_SCHEDULE",
    "FLS_SIGN_SCHEDULE"
  ],
  "schedule_columns": {
    "ROOM_SCHEDULE": ["room_id", "name", "level", "area_m2", "area_basis", "program", "occupancy_status", "provenance"],
    "DOOR_SCHEDULE": ["door_id", "level", "from_space", "to_space", "nominal_width_m", "clear_width_m", "height_m", "swing", "fire_rating", "material", "host_status", "provenance"],
    "WINDOW_SCHEDULE": ["window_id", "level", "host_wall", "width_m", "height_m", "sill_m", "type", "material", "provenance"],
    "COLUMN_SCHEDULE": ["column_id", "level", "section", "material", "height_m", "grid_refs", "provenance"],
    "BEAM_SCHEDULE": ["beam_id", "level", "section", "material", "length_m", "provenance"],
    "SLAB_SCHEDULE": ["slab_id", "level", "thickness_m", "material", "outline", "provenance"],
    "FOUNDATION_SCHEDULE": ["foundation_id", "type", "depth_m", "embedment_m", "material", "provenance"],
    "MEP_EQUIPMENT_SCHEDULE": ["equipment_id", "level", "type", "system", "discipline", "provenance"],
    "MEP_TERMINAL_SCHEDULE": ["terminal_id", "level", "type", "system", "space", "provenance"],
    "FLS_DEVICE_SCHEDULE": ["device_id", "level", "type", "category", "space", "provenance"],
    "FLS_SIGN_SCHEDULE": ["sign_id", "level", "kind", "indicates_exit", "illuminated", "provenance"]
  },
  "schedule_row_fields": ["source_element_id", "source_model_hash", "discipline", "provenance"],
  "schedule_note": "a schedule is a view over the model, not an independent database. Every row carries the identifier of the element it reports and the model hash it was read from. A missing value stays missing.",
  "forbidden_schedule_invention": [
    "clear_width_from_nominal_width",
    "fire_rating_from_door_type",
    "material_from_element_kind",
    "section_from_span",
    "capacity_from_equipment_type",
    "occupancy_from_room_name"
  ],
  "nominal_is_not_clear_note": "nominal width is the opening width. Clear width is a different measurement and is reported only when the model states it. One never substitutes for the other.",

  "quantity_types": [
    "ROOM_COUNT",
    "DOOR_COUNT",
    "WINDOW_COUNT",
    "WALL_LENGTH",
    "FLOOR_AREA",
    "SPACE_AREA",
    "LEVEL_COUNT",
    "COLUMN_COUNT",
    "BEAM_COUNT",
    "BEAM_LENGTH",
    "FOUNDATION_COUNT",
    "MEP_EQUIPMENT_COUNT",
    "MEP_TERMINAL_COUNT",
    "MEP_SEGMENT_LENGTH",
    "FLS_DEVICE_COUNT",
    "FLS_SIGN_COUNT"
  ],
  "quantity_fields": ["quantity_id", "quantity_type", "quantity", "unit", "source_element_ids", "measurement_basis", "coverage_status"],
  "coverage_statuses": ["COMPLETE_FOR_REPRESENTED_MODEL", "PARTIAL", "NOT_AVAILABLE"],
  "quantity_note": "this is a factual model quantity report, not a bill of quantities and not an estimate. Coverage is stated against the represented model only; a partial coverage is reported as PARTIAL rather than rounded up to complete.",
  "boq_claimed": false,
  "cost_estimation_supported": false,
  "forbidden_quantity_fields": ["price", "rate", "cost", "currency", "budget", "labour_rate", "material_price", "unit_cost", "total_cost", "market_price"],

  "paper_sizes": {
    "A0": [1189, 841],
    "A1": [841, 594],
    "A2": [594, 420],
    "A3": [420, 297],
    "A4": [297, 210]
  },
  "default_paper_size": "A3",
  "paper_note": "the paper size is always explicit. No project is assumed to be A1.",
  "orientations_sheet": ["LANDSCAPE", "PORTRAIT"],
  "scales": ["1:20", "1:50", "1:100", "1:200", "1:500"],
  "scale_modes": ["TRUE_SCALE", "FIT_TO_SHEET"],
  "scale_note": "a true engineering scale is reported only when the view fits the viewport at that scale. Otherwise the mode is FIT_TO_SHEET and the true scale is reported as NOT_APPLICABLE rather than invented.",

  "sheet_fields": [
    "sheet_id",
    "sheet_number",
    "sheet_name",
    "paper_size",
    "orientation",
    "title_block_id",
    "views",
    "schedules",
    "legends",
    "notes",
    "revision",
    "source_model_hash"
  ],
  "viewport_fields": ["viewport_id", "view_id", "x", "y", "width", "height", "scale", "scale_mode", "crop"],
  "viewport_overlap_allowed": false,
  "viewport_note": "a viewport collision is detected and reported. Engineering content is never silently moved to make a sheet look tidy.",

  "title_block_fields": [
    "project",
    "building",
    "sheet_title",
    "sheet_number",
    "revision",
    "date",
    "scale",
    "drawn_by",
    "checked_by",
    "status"
  ],
  "title_block_note": "unknown fields stay blank. No company name, engineer name, licence number or approval stamp is generated.",
  "forbidden_title_block_content": ["company_name", "engineer_name", "licence_number", "stamp", "seal", "signature", "approval"],

  "drawing_statuses": ["DRAFT", "FOR_REVIEW", "ISSUED"],
  "restricted_statuses": ["APPROVED_FOR_CONSTRUCTION", "IFC", "CERTIFIED", "AS_BUILT"],
  "restricted_status_note": "a restricted status is never set by the system. It requires an explicit authorised user action, and this phase does not grant that authority.",

  "discipline_prefixes": {
    "ARCHITECTURE": "A",
    "STRUCTURE": "S",
    "MECHANICAL": "M",
    "ELECTRICAL": "E",
    "PLUMBING": "P",
    "FIRE_PROTECTION": "F",
    "COORDINATION": "C",
    "ICT": "T"
  },
  "prefixes_configurable": true,

  "revision_fields": ["revision", "date", "description", "source_model_revision", "changed_sheets"],
  "revision_append_only": true,
  "revision_author_invented": false,
  "revision_cloud_from_diff_only": true,
  "revision_cloud_note": "a revision cloud is emitted only from an actual documentation or model diff, and it carries no engineering interpretation of the change.",

  "documentation_states": ["CURRENT", "STALE_MODEL_CHANGED", "STALE_DEFINITION_CHANGED", "REGENERATED", "SUPERSEDED"],
  "staleness_note": "when the engineering model moves, existing artifacts become STALE_MODEL_CHANGED. They are never silently regenerated and never keep reporting CURRENT. Regeneration produces a new documentation revision and preserves the previous one.",
  "auto_regenerate": false,
  "history_overwrite_allowed": false,

  "export_formats": ["SVG", "PDF", "JSON"],
  "optional_export_formats": [],
  "optional_export_note": "DXF is not implemented in this phase. No file is emitted with a DXF extension, because a renamed file is not an exchange format.",
  "pdf_version": "1.4",
  "pdf_note": "sheets are written as a real PDF: a %PDF- header, a catalogue, a page tree, one page per sheet with an explicit MediaBox in points, uncompressed content streams of vector operators, an xref table and a trailer. No raster screenshot is embedded as the drawing content.",
  "svg_note": "SVG output is real vector geometry. No screenshot is embedded as the only drawing content.",
  "export_set_fields": ["export_set_id", "name", "purpose", "sheets", "formats", "created_at"],
  "export_set_note": "an export set name is documentation metadata chosen by the user. It implies no authority, no submission and no approval.",
  "export_manifest_fields": [
    "manifest_id",
    "documentation_id",
    "documentation_revision",
    "model_hash",
    "source_revision",
    "files",
    "artifact_ids",
    "sheet_ids",
    "generated_at",
    "spec_version"
  ],
  "export_file_fields": ["file_name", "format", "artifact_id", "sheet_id", "byte_length", "file_hash", "generation_mode"],
  "generation_modes": ["DETERMINISTIC_VECTOR", "DETERMINISTIC_TABLE", "DETERMINISTIC_PACKAGE"],

  "deterministic_fields": [
    "documentation_id",
    "view_id",
    "sheet_id",
    "schedule_id",
    "quantity_id",
    "dimension_id",
    "annotation_id",
    "artifact_id",
    "file_hash"
  ],
  "non_deterministic_fields": ["generated_at"],
  "determinism_note": "the same canonical model with the same documentation definition produces the same artifact identities and the same vector bytes. generated_at is descriptive and is excluded from every identity.",
  "pdf_parity_basis": "SEMANTIC_CONTENT_STREAM",
  "pdf_parity_note": "the PDF byte stream is compared through its page count, MediaBoxes and the exact content-stream operator text, which is the whole drawing. The surrounding object offsets are a function of byte lengths and are compared as a derived xref rather than waived.",

  "id_prefixes": {
    "documentation": "doc_",
    "view": "view_",
    "sheet": "sheet_",
    "schedule": "sched_",
    "quantity": "qty_",
    "dimension": "dim_",
    "annotation": "ann_",
    "viewport": "vp_",
    "legend": "leg_",
    "export_set": "exp_",
    "manifest": "docman_"
  },
  "id_hash_length": 16,
  "random_ids_allowed": false,

  "line_weights": {
    "CUT": 0.7,
    "PROJECTED": 0.35,
    "ANNOTATION": 0.25,
    "DIMENSION": 0.18,
    "GRID": 0.18,
    "REFERENCE": 0.13,
    "COORDINATION": 0.5
  },
  "line_styles": {
    "CUT": "solid",
    "PROJECTED": "solid",
    "ANNOTATION": "solid",
    "DIMENSION": "solid",
    "GRID": "dash",
    "REFERENCE": "dash",
    "COORDINATION": "solid"
  },
  "drawing_modes": ["MONOCHROME", "TECHNICAL", "PRESENTATION"],
  "default_drawing_mode": "MONOCHROME",
  "monochrome_ink": "#000000",
  "monochrome_paper": "#ffffff",
  "style_changes_meaning": false,
  "presentation_requires_label": true,
  "presentation_label": "PRESENTATION — NOT A CONSTRUCTION DRAWING",
  "technical_drawing_ai_content_allowed": false,

  "construction_drawing_claimed": false,
  "regulatory_claimed": false,
  "professional_stamp_claimed": false,
  "cad_interoperability_claimed": false,
  "compliance_language_forbidden": [
    "code compliant",
    "coverage compliant",
    "adequate",
    "protected",
    "approved for construction",
    "certified",
    "meets the code",
    "conforms to",
    "fire rated as required"
  ],

  "languages": ["en", "ar"],
  "rtl_language": "ar",
  "rtl_affects_geometry": false,
  "rtl_note": "language direction changes the interface and the reading order of labels. Sheet coordinates, drawing geometry and viewport placement are never mirrored because the interface is right to left.",
  "ui_labels": {
    "en": {
      "panel": "Documentation",
      "views": "Views",
      "floor_plans": "Floor plans",
      "elevations": "Elevations",
      "sections": "Sections",
      "details": "Details",
      "discipline_plans": "Discipline plans",
      "schedules": "Schedules",
