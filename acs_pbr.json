    "CLEAR_NOON": {"sun_azimuth_deg": 180, "sun_elevation_deg": 70, "sun_intensity": 2.8, "sun_color": "#fffdf5", "hemisphere_intensity": 0.6, "ambient_intensity": 0.0, "exposure": 1.05, "shadows": true, "background": "SKY", "fills": []},
