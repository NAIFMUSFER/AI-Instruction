  "material_count": 20,
  "material_license": "PROCEDURAL",
  "material_note": "every presentation material is procedural and visual-only. No material here carries a fire rating, a structural grade, a U-value or any engineering meaning, and none is ever written back to the model.",

  "engineering_material_map": {
    "wall": "painted_wall",
    "ceiling": "plaster",
    "floor": "ceramic_tile",
    "door": "wood",
    "window": "glass_clear",
    "steel": "steel_structural",
    "beam": "steel_painted",
    "deck": "steel_painted",
    "frame": "rack_steel",
    "guard": "safety_paint",
    "goods": "carton",
    "pallet": "wood",
    "belt": "plastic",
    "furn": "wood",
    "furn_soft": "fabric",
    "ac": "aluminum",
    "dockdoor": "steel_painted",
    "counter": "stone",
    "roof": "roof_membrane"
  },
  "unmapped_material_policy": "KEEP_ENGINEERING_APPEARANCE",

