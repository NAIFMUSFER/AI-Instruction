    "PRESENTATION_SOFT": {"sun_azimuth_deg": 60, "sun_elevation_deg": 35, "sun_intensity": 1.8, "sun_color": "#fff8ee", "hemisphere_intensity": 0.8, "ambient_intensity": 0.1, "exposure": 1.02, "shadows": true, "background": "SKY", "fills": [{"azimuth_deg": 240, "elevation_deg": 25, "intensity": 0.35, "color": "#e8eefc", "visual_only": true}]}
  },
  "lighting_note": "presentation lights are VISUAL_ONLY. Represented MEP light fixtures remain engineering data and are never reused as presentation lights; an emissive fixture glow is appearance, not a luminaire schedule.",
  "mep_lights_reused_as_presentation": false,

  "environment_modes": {
    "NEUTRAL": {"source": "ROOM_ENVIRONMENT", "intensity": 1.0},
    "SKY": {"source": "PROCEDURAL_SKY", "intensity": 1.0},
    "STUDIO": {"source": "ROOM_ENVIRONMENT", "intensity": 1.25}
  },
  "environment_note": "environment lighting is generated locally through PMREM from the procedural sky or the bundled room environment. No HDRI is fetched from any remote host at runtime; a local HDR asset may only come from the declared asset root.",
  "remote_environment_allowed": false,

  "shadow_tiers": {
    "LOW":    {"map_size": 1024, "bias": -0.0005, "normal_bias": 0.02, "radius": 1.0},
    "MEDIUM": {"map_size": 2048, "bias": -0.0004, "normal_bias": 0.03, "radius": 2.0},
    "HIGH":   {"map_size": 4096, "bias": -0.0003, "normal_bias": 0.04, "radius": 3.0},
    "ULTRA":  {"map_size": 8192, "bias": -0.00025, "normal_bias": 0.05, "radius": 4.0}
  },
  "shadow_type": "PCF_SOFT",
  "shadow_camera_margin": 1.15,
  "shadow_note": "the shadow camera extents are computed from the actual model bounds with the declared margin — no building size is hard-coded. Bias and normal bias are tuned against acne and peter-panning per tier.",

  "quality_profiles": {
    "PERFORMANCE": {"pixel_ratio_max": 1.0, "shadow_tier": "LOW", "ssao": false, "antialias": "RENDERER_MSAA", "environment": "NEUTRAL", "post_processing": false, "bloom": false},
    "BALANCED":    {"pixel_ratio_max": 1.5, "shadow_tier": "MEDIUM", "ssao": false, "antialias": "RENDERER_MSAA", "environment": "SKY", "post_processing": false, "bloom": false},
    "HIGH":        {"pixel_ratio_max": 2.0, "shadow_tier": "HIGH", "ssao": true, "antialias": "FXAA_COMPOSER", "environment": "SKY", "post_processing": true, "bloom": false},
    "ULTRA":       {"pixel_ratio_max": 2.0, "shadow_tier": "ULTRA", "ssao": true, "antialias": "FXAA_COMPOSER", "environment": "SKY", "post_processing": true, "bloom": true}
  },
  "quality_requirements": {
    "PERFORMANCE": {"webgl2": false, "min_max_texture_size": 2048},
    "BALANCED":    {"webgl2": false, "min_max_texture_size": 4096},
    "HIGH":        {"webgl2": true,  "min_max_texture_size": 8192},
    "ULTRA":       {"webgl2": true,  "min_max_texture_size": 16384}
  },
  "quality_fallback_chain": ["ULTRA", "HIGH", "BALANCED", "PERFORMANCE"],
  "auto_max_profile": "HIGH",
  "quality_note": "ULTRA is never selected automatically; it is a user choice gated by capability detection. When a capability requirement fails the profile degrades down the declared chain — HIGH to BALANCED to PERFORMANCE — and the degradation is reported, never silent. A failed effect never blanks the viewport.",

  "post_processing_modules": [
    "postprocessing/EffectComposer.js",
    "postprocessing/RenderPass.js",
    "postprocessing/ShaderPass.js",
    "postprocessing/OutputPass.js",
    "postprocessing/SSAOPass.js",
    "shaders/FXAAShader.js",
    "shaders/CopyShader.js",
    "shaders/SSAOShader.js"
  ],
  "post_processing_note": "post-processing modules are vendored locally from the pinned three@0.160.0 examples tree and imported from the same origin. If a module is absent or fails to initialise, the standard renderer path remains and the failure is reported as PQ_POST_UNAVAILABLE.",
  "bloom_note": "bloom, where enabled on ULTRA, is subtle exposure-relative glow only. Gaming or neon visuals are out of contract.",

  "camera_presets": {
    "EXTERIOR_HERO":      {"fov": 42, "azimuth_deg": 35, "elevation_deg": 18, "distance_factor": 2.6, "target": "CENTER", "eye_height_m": null},
    "EXTERIOR_CORNER":    {"fov": 45, "azimuth_deg": 135, "elevation_deg": 22, "distance_factor": 2.4, "target": "CENTER", "eye_height_m": null},
    "EYE_LEVEL":          {"fov": 55, "azimuth_deg": 20, "elevation_deg": 0, "distance_factor": 2.2, "target": "EYE", "eye_height_m": 1.6},
    "AERIAL":             {"fov": 40, "azimuth_deg": 210, "elevation_deg": 55, "distance_factor": 3.0, "target": "CENTER", "eye_height_m": null},
    "INTERIOR_WIDE":      {"fov": 62, "azimuth_deg": 45, "elevation_deg": 8, "distance_factor": 0.45, "target": "CENTER", "eye_height_m": 1.6},
    "INTERIOR_EYE_LEVEL": {"fov": 58, "azimuth_deg": 90, "elevation_deg": 0, "distance_factor": 0.4, "target": "EYE", "eye_height_m": 1.6},
    "WAREHOUSE_OVERVIEW": {"fov": 50, "azimuth_deg": 320, "elevation_deg": 35, "distance_factor": 2.2, "target": "CENTER", "eye_height_m": null},
    "DOLLHOUSE":          {"fov": 45, "azimuth_deg": 225, "elevation_deg": 40, "distance_factor": 2.4, "target": "CENTER", "eye_height_m": null}
  },
  "fov_min": 20,
  "fov_max": 75,
  "camera_note": "every preset frames from the real model bounds, deterministically. FOV is clamped to an architecturally sane range; no fisheye and no arbitrary clipping through geometry by construction of the distance factor.",

  "ground_context": {
    "enabled_default": true,
    "group_name": "PQ_CONTEXT",
    "visual_only": true,
    "ground_materials": ["soil", "asphalt", "concrete_polished"],
    "default_ground_material": "soil",
    "size_factor": 6.0,
    "roads_generated": false,
    "parking_generated": false,
    "landscaping_generated": false,
    "neighboring_buildings_generated": false,
    "excluded_from": ["BIM", "DOCUMENTATION", "QUANTITIES", "ENGINEERING_GLB", "MODEL_HASH"],
    "note": "presentation context is a ground plane and a sky only. It lives in the scene, never in the building group, so it is structurally excluded from the engineering GLB export, from BIM, from documentation and from quantities."
  },

  "exposure_min": 0.5,
  "exposure_max": 1.8,
  "exposure_step": 0.05,
  "tone_mapping": "ACES_FILMIC",
  "output_color_space": "SRGB",
  "color_note": "output color space is sRGB with ACES filmic tone mapping for presentation presets. Exposure is clamped to the declared range against washed-out whites and crushed blacks.",

  "capture": {
    "type": "PRESENTATION_OUTPUT",
    "is_engineering_evidence": false,
    "resolutions": [[1280, 720], [1920, 1080], [2560, 1440]],
    "max_dimension_px": 4096,
    "transparent_background_allowed": true,
    "metadata_fields": ["type", "camera_preset", "quality_profile", "lighting_preset", "materials_mode", "environment", "exposure", "model_hash", "presentation_config_hash", "width_px", "height_px", "generated_at", "is_engineering_evidence"]
  },

  "texture_policy": {
    "local_only": true,
    "allowed_asset_root": "assets/materials/",
    "safe_asset_pattern": "^assets/materials/[A-Za-z0-9][A-Za-z0-9._\\-]{0,80}\\.(png|jpg|jpeg|webp|hdr)$",
    "allowed_schemes": [],
    "remote_texture_allowed": false,
    "local_texture_sets": [],
    "map_kinds": ["base_color", "roughness", "normal", "ao"],
    "world_scale_tiling": true,
    "missing_texture_fallback": "PROCEDURAL_PBR",
    "note": "textures load only from the declared same-origin asset root and only when listed in local_texture_sets. The shipped default set is empty, so the renderer performs zero texture fetches and falls back to the deterministic procedural materials — no broken texture icon and no network dependency. World-scale tiling reuses the existing per-face UV scaling; a texture is never stretched independently per mesh."
  },

  "unsafe_patterns": [
    "javascript:",
    "data:text/html",
    "<script",
    "onerror=",
    "eval(",
    "new Function",
    "file://",
    "../",
    "..\\"
  ],
  "forbidden_property_keys": [
    "__proto__",
    "constructor",
    "prototype",
    "__defineGetter__",
    "__defineSetter__",
    "__lookupGetter__",
    "__lookupSetter__"
  ],

  "limits": {
    "max_pixel_ratio": 2.0,
    "max_fill_lights": 4,
    "max_capture_px": 4096,
    "max_override_fields": 12,
    "max_asset_path_length": 100,
    "max_exposure": 1.8,
    "min_exposure": 0.5,
    "max_shadow_map": 8192
  },

  "issue_codes": [
    "PQ_INVALID_PROFILE",
    "PQ_INVALID_PRESET",
    "PQ_INVALID_MATERIAL",
    "PQ_INVALID_MODE",
    "PQ_INVALID_ENVIRONMENT",
    "PQ_INVALID_EXPOSURE",
    "PQ_INVALID_RESOLUTION",
    "PQ_INVALID_OVERRIDE",
    "PQ_UNSAFE_ASSET_PATH",
    "PQ_REMOTE_ASSET_REFUSED",
    "PQ_UNSUPPORTED_CAPABILITY",
    "PQ_FALLBACK_APPLIED",
    "PQ_THREE_UNAVAILABLE",
    "PQ_POST_UNAVAILABLE",
    "PQ_PROPERTY_REFUSED"
  ],
  "blocking_issue_codes": [
    "PQ_INVALID_PROFILE",
    "PQ_INVALID_PRESET",
    "PQ_INVALID_MATERIAL",
    "PQ_INVALID_MODE",
    "PQ_INVALID_ENVIRONMENT",
    "PQ_INVALID_RESOLUTION",
    "PQ_UNSAFE_ASSET_PATH",
    "PQ_REMOTE_ASSET_REFUSED"
