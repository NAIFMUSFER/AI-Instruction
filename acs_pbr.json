{
  "schema": "acs.pbr/1",
  "version": "1.0.0",
  "compiler_version": "acs-pbr/1.0.0",

  "presentation_only": true,
  "writes_to_model": false,
  "reverse_write_allowed": false,
  "mutates_engineering_model": false,
  "model_hash_inputs": ["model"],
  "presentation_config_hash_inputs": ["config"],
  "authority_note": "this layer upgrades how the model LOOKS. It never changes what the model IS. Every value here is a presentation value; no roughness, metalness, transmission or emissive figure is ever evidence of an engineering property, and the canonical model hash is computed from the model alone.",

  "pipeline": [
    "CANONICAL_ENGINEERING_MODEL",
    "READ_ONLY_PRESENTATION_COMPILER",
    "REALTIME_PBR_SCENE",
    "OPTIONAL_POST_PROCESSING",
    "SCREEN_OR_IMAGE_OUTPUT"
  ],
  "reverse_arrow_exists": false,

  "quality_positioning": "real-time physically based rendering in a browser viewport. This is not path tracing and not an offline renderer, and no photorealism claim is made beyond what real-time PBR achieves.",
  "photorealism_claimed": false,
  "offline_render_claimed": false,
  "path_tracing_claimed": false,

  "provenance_classes": [
    "ENGINEERING_VALUE",
    "USER_VISUAL_OVERRIDE",
    "PRESENTATION_DEFAULT"
  ],
  "provenance_note": "a presentation material is PRESENTATION_DEFAULT unless the user overrides a field, which marks that field USER_VISUAL_OVERRIDE. ENGINEERING_VALUE never originates in this layer; nothing here is promoted into an engineering material property.",
  "engineering_material_promotion_allowed": false,

  "materials_modes": ["ENGINEERING", "REALISTIC"],
  "default_materials_mode": "ENGINEERING",
  "materials_mode_note": "ENGINEERING keeps the existing readable engineering appearance untouched. REALISTIC swaps the visual appearance of mapped mesh classes for the PBR presentation materials below, reversibly, in the scene only.",

