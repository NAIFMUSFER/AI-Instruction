{
  "schema": "acs.archdetail",
  "version": "9.2.0",
  "presentation_layer_version": "9.2.0",
  "note": "Phase 9.2 — architectural visual fidelity, façade detailing and presentation context. A read-only layer DOWNSTREAM of the canonical model and the Phase 9.1 PBR layer. It extends acs_pbr; it never replaces it, never duplicates its lighting/material/camera/quality registries, and never writes anything into engineering geometry, structure, MEP, FLS, BIM, documentation, quantities, navigation, compliance or authoring history.",
  "extends": "acs.pbr",
  "presentation_only": true,
  "writes_to_model": false,
  "reverse_write_allowed": false,
  "reverse_arrow_exists": false,
  "mutates_engineering_model": false,
  "photorealism_claimed": false,
  "path_tracing_claimed": false,
  "ray_tracing_claimed": false,
  "global_illumination_claimed": false,
  "physically_simulated_sunlight_claimed": false,
  "bim_grade_facade_detailing_claimed": false,
  "construction_detailing_claimed": false,
  "code_compliance_claimed": false,
  "parking_engineering_claimed": false,
  "landscape_design_claimed": false,
  "lighting_design_claimed": false,
  "pipeline": [
    "CANONICAL_ENGINEERING_MODEL",
    "EXISTING_VISUAL_COMPILER",
    "EXISTING_PBR_LAYER",
    "ARCHITECTURAL_PRESENTATION_DETAIL_LAYER",
    "LIGHTING_ENVIRONMENT_POST_PROCESS",
    "VIEWPORT_OR_IMAGE"
  ],
  "model_hash_inputs": ["model"],
  "presentation_config_hash_inputs": ["config"],

  "detail_classes": {
    "CANONICAL_GEOMETRY": "directly represented by the canonical model",
    "DERIVED_PRESENTATION_DETAIL": "safe visual derivative of existing geometry, e.g. a frame generated around an existing window opening",
    "REQUESTED_PRESENTATION_DETAIL": "explicitly requested by the user but not engineering-authoritative, e.g. a beige stone facade appearance",
    "DEFAULT_PRESENTATION_CONTEXT": "neutral context added solely for visualization, e.g. a ground plane",
    "UNRESOLVED": "the requested item cannot be represented safely without engineering invention"
  },
  "detail_class_promotion_allowed": false,

  "object_authority_classes": {
    "CANONICAL_OBJECT": "the canonical model already contains the object; presentation may improve its visual geometry and materials",
    "USER_REQUESTED_OBJECT": "explicitly requested and carried by the existing object-preservation layer; rendered as presentation geometry without becoming engineering truth",
    "PRESENTATION_CONTEXT_OBJECT": "added only when presentation context/staging is explicitly enabled; visual_only and presentation_context both true",
    "UNRESOLVED_OBJECT": "placement, size, type or quantity cannot be determined safely; never fabricated"
  },

  "required_flags_on_presentation_objects": [
    "visual_only", "source_element_id", "provenance", "confidence", "reason"
  ],
  "context_flag": "presentation_context",

  "detail_profiles": {
    "DETAIL_OFF": {
      "note": "Phase 9.1 appearance only",
      "window_frames": false, "reveals": false, "facade_zoning": false,
      "furniture_detail": "PHASE9_1", "context_objects": false,
      "led_lighting": false, "landscape_lod": "NONE", "ao_boost": false
    },
    "DETAIL_STANDARD": {
      "note": "frames + reveals + material zoning + moderate furniture detail",
      "window_frames": true, "reveals": true, "facade_zoning": true,
      "furniture_detail": "STANDARD", "context_objects": true,
      "led_lighting": true, "landscape_lod": "STANDARD", "ao_boost": false
    },
    "DETAIL_HIGH": {
      "note": "higher presentation detail + enhanced context + stronger AO/shadows; no ultra-high mesh density",
      "window_frames": true, "reveals": true, "facade_zoning": true,
      "furniture_detail": "HIGH", "context_objects": true,
      "led_lighting": true, "landscape_lod": "HIGH", "ao_boost": true
    }
  },
  "default_detail_profile": "DETAIL_OFF",
  "mobile_detail_fallback": {"DETAIL_HIGH": "DETAIL_STANDARD"},
  "mobile_may_disable_ssao": true,
  "mobile_may_reduce_landscape": true,
  "blank_viewport_allowed": false,
  "canonical_object_removal_allowed": false,

  "presentation_offset_max_m": 0.06,
  "presentation_offset_note": "every visual-only depth element (cladding skin, reveal, trim, sill, lintel cap, panel offset, parapet coping, balcony edge finish) stays within this offset of its canonical source surface. It never changes canonical dimensions and is removable with no model change.",

  "facade_zone_materials": [
    "stone_beige", "plaster_painted", "plaster_architectural",
    "concrete_exposed_zone", "panel_gray", "wood_accent",
    "metal_cladding", "glass_zone"
  ],
  "facade_zoning_rules": {
    "primary_source": "exterior wall surfaces already represented by the canonical compiler",
    "accent_sources": ["parapet band if represented", "base course band within offset tolerance", "distinct represented wall groups"],
    "invent_walls": false,
    "change_wall_thickness": false,
    "unresolved_issue": "AD_VISUAL_DETAIL_UNRESOLVED",
    "note": "zoning assigns presentation materials to EXISTING represented surfaces only. If a requested accent zone cannot be deterministically derived, it is reported unresolved — never fabricated."
  },

  "window_assembly": {
    "parts": ["frame", "glass_pane", "sill", "reveal"],
    "frame_finishes": {"dark": "#2b2e33", "gray": "#6b7077", "light": "#c9ccd1"},
    "default_frame_finish": "dark",
    "frame_material": "aluminum",
    "frame_thickness_ratio": 0.045,
    "frame_thickness_min_m": 0.03,
    "frame_thickness_max_m": 0.09,
    "frame_depth_m": 0.05,
    "sill_depth_m": 0.04,
    "sill_drop_m": 0.02,
    "changes_opening_size": false,
    "changes_opening_position": false,
    "changes_window_count": false
  },

  "door_visual_classes": {
    "wood_solid": {"material": "wood", "note": "default residential leaf"},
    "metal_painted": {"material": "steel_painted", "note": "service/plant rooms when represented as metal"},
    "alu_glass": {"material": "aluminum", "glass": true, "note": "represented glass doors"},
    "service_door": {"material": "steel_painted", "note": "represented service doors"},
    "entrance_door": {"material": "wood", "emphasis": true, "note": "represented main entrance"},
    "warehouse_dock_door": {"material": "galvanized_metal", "note": "represented dock doors"},
    "generic": {"material": "wood", "note": "unknown represented type — generic presentation door"}
  },
  "door_class_evidence_map": {
    "door_glass": "alu_glass", "dockdoor": "warehouse_dock_door", "door": "wood_solid"
  },
  "door_inference_forbidden": ["fire_rating", "security_rating", "engineering_material_truth"],

  "balcony_rules": {
    "represented_when": ["space role balcony", "railing objects hosted on an exterior edge"],
    "enhancements": ["slab finish", "fascia material", "parapet finish", "railing finish if represented", "underside contact shadow", "edge definition"],
    "create_engineering_geometry": false,
    "unrepresented_request_status": "REQUESTED_BUT_NOT_REPRESENTED",
    "ui_note_en": "Balcony requested but not represented in canonical geometry.",
    "ui_note_ar": "طُلبت بلكونة لكنها غير ممثَّلة في النموذج القانوني."
  },

  "roofline_rules": {
    "enhance_only_if_represented": ["parapet", "roof edge", "rooftop enclosure", "mechanical room", "stair headhouse", "elevator shaft"],
    "invent_rooftop_equipment": false,
    "invent_height": false
  },

  "led_lighting": {
    "types": ["facade_strip", "balcony_strip", "entrance_wash", "cove", "wall_washer", "bollard_light"],
    "visual_only": true,
    "mep_reuse_forbidden": true,
    "creates": [],
    "never_creates": ["electrical_circuit", "load", "panel_assignment", "cable_route", "mep_fixture_schedule_entry"],
    "requires_represented_host": true,
    "emissive_intensity": 1.6,
    "strip_height_m": 0.04,
    "strip_depth_m": 0.03
  },

  "interior_detail_scope": ["wall finish", "floor finish", "ceiling appearance", "door appearance", "window glass depth", "cabinetry", "counters", "wardrobes", "furniture material", "sanitary fixtures where represented", "appliances where represented"],
  "interior_invention_allowed": false,

  "staging_modes": {
    "STAGING_OFF": "no staging objects at all",
    "STAGING_REQUESTED_ONLY": "improve only objects the canonical object-preservation layer carries",
    "STAGING_PRESENTATION_DEFAULT": "explicitly user-selected; added items are visual_only + presentation_context and never enter BIM, quantities, engineering exports or documentation schedules"
  },
  "default_staging_mode": "STAGING_REQUESTED_ONLY",

  "kitchen_layouts": ["L", "U", "LINEAR", "PARALLEL"],
  "kitchen_layout_rule": "a layout is chosen only when the canonical model has selected one; an ambiguous phrase like «L أو U حسب الدور» resolves to AD_KITCHEN_LAYOUT_UNRESOLVED, never to an invented deterministic engineering layout",

  "bathroom_fixtures": ["toilet", "sink", "shower", "bath", "mirror", "vanity"],
  "bathroom_rules": {"place_if_absent": false, "infer_plumbing": false},

  "site_presentation": {
    "classes": ["CANONICAL_SITE", "REQUESTED_SITE_PRESENTATION", "DEFAULT_CONTEXT"],
    "surfaces": ["neutral_plane", "paving", "asphalt", "curb", "entry_path", "parking_surface"],
    "invent_site_boundaries": false,
    "invent_roads": false
  },

  "parking_rules": {
    "represented_when": ["space role parking", "objects of kind parking_bay"],
    "visual": ["asphalt_or_paving", "painted_bay_markings", "wheel_stops if represented or requested", "disabled_bay_marking only if represented", "directional_arrows only if represented or requested"],
    "invent_bay_count": false,
    "unresolved_status": "PARKING_REQUESTED_NOT_GEOMETRICALLY_RESOLVED",
    "neutral_zone_requires_explicit_enable": true
  },

  "landscape": {
    "assets": ["tree", "palm", "shrub", "hedge", "planter", "grass", "ground_cover", "gravel", "paving", "curb", "path"],
    "default": "OFF",
    "enable_via": ["explicit user request", "presentation context mode"],
    "lods": ["LOW", "STANDARD", "HIGH"],
    "enters_engineering_model": false,
    "fake_irrigation": false,
    "fake_species": false,
    "fake_tree_count": false
  },

  "entrance_rules": {
    "enhance_if_represented": ["material differentiation", "light wash", "door framing", "paving approach", "camera composition"],
    "canopy_only_if_represented": true
  },

  "vertical_core_rules": {
    "enhance": ["stair", "elevator_shaft", "core_walls"],
    "invent_forbidden": ["manufacturer", "speed", "capacity", "cabin_dimensions"],
    "unverified_capacity_is_request_provenance_only": true
  },

  "fls_presentation_rules": {
    "enhance_existing_only": ["extinguisher", "sprinkler", "smoke", "sign", "camera"],
    "add_missing_devices": false,
    "imply_coverage_or_compliance": false
  },

  "variation": {
    "deterministic": true,
    "seed_inputs": ["model_hash", "element_id", "material_id"],
    "roughness_jitter_max": 0.08,
    "albedo_jitter_max": 0.05,
    "normal_perturb_max": 0.3,
    "note": "the same model always renders the same visual variation; no runtime randomness"
  },

