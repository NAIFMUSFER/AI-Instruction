# =============================================================================
# .env.example — أسماء المتغيّرات فقط. لا تضع قيمة سرّية في هذا الملفّ ولا في
# أي ملفّ داخل المستودع. المفتاح يُدخل يدوياً في لوحة Render (sync: false).
#
#   cp .env.example .env      ثمّ املأ القيم محلياً فقط — .env غير منشور
# =============================================================================

# ── سرّي — يُدخل في بيئة الخادوم وحدها، ولا يظهر في مصدر العميل ولا في سجلّ ──
ANTHROPIC_API_KEY=

# ── النموذج — لا يُغيَّر دون تحقّق من وثائق Anthropic الرسمية أو الواجهة الحيّة ──
ACS_LLM_MODEL=claude-sonnet-5

# ── الأمان: نطاقات الواجهة المسموح بها، مفصولة بفواصل. لا تستعمل * في الإنتاج ──
ACS_ALLOWED_ORIGINS=https://sprightly-selkie-d906c3.netlify.app
# وكلاء موثوقون لقراءة عنوان الزائر الحقيقي (اختياري)
ACS_TRUSTED_PROXIES=

# ── حماية الرصيد: حدود الطلبات ──
ACS_RL_GEN_HOUR=8
ACS_RL_GEN_DAY=25
ACS_RL_EDIT_HOUR=30
ACS_RL_GLOBAL_DAY=400

# ── حدود المدخلات ──
ACS_MAX_TEXT=60000
ACS_MAX_DESC=120000
# F-19: هذان كانا فارغَين، والملفّ نفسه يوصي بـ`cp .env.example .env` — فكان
# `int("")` يرفع ValueError عند استيراد acs_understand_api فلا يقلع الخادم
# إطلاقاً. صار الفراغ يعود إلى الافتراضي، والقيمتان مكتوبتان هنا صراحةً حتى لا
# يعتمد الضبط على سلوك ضمني.
ACS_MAX_BUILDING=900000
ACS_MAX_UPLOAD_MB=12
# سقف مجموع أحرف الملاحظات في /v1/edit و/v1/understand/image (F-20).
ACS_MAX_NOTES_CHARS=20000
# ── حدود الرفع (F-22 · F-23) ──
# ذاكرة الرستر بعد فكّ ترميز الصورة — الحدّ الوحيد الذي يقيس البايتات لا البكسلات.
ACS_UPLOAD_MAX_IMAGE_DECODED_BYTES=33554432
# مجموع ما تتمدّد إليه مجاري PDF المضغوطة — حارس قنبلة الانضغاط.
ACS_UPLOAD_MAX_PDF_DECOMPRESSED_BYTES=25165824

# ── ميزانية المخرج (المصدر الوحيد) واستراتيجية التوليد ──
# كل ميزانيات المراحل مشتقّة من هذا الرقم. ACS_MAX_TOKENS يبقى مرادفاً قديماً.
ACS_LLM_MAX_OUTPUT_TOKENS=32000
# حدود التصعيد بعد انقطاع المخرج — لا حلقات لا نهائية
ACS_MAX_ESCALATIONS=1
ACS_MAX_GROUP_SPLITS=2

# ── التوليد على مرحلتين ──
ACS_DEEP=auto
ACS_GROUP_SIZE=5
ACS_WORKERS=4
ACS_MAX_GROUPS=14
# F-19: كان فارغاً، و`int("")` في acs_understand.py:1216 يرفع ValueError داخل
# عملية التوليد فيصل المستخدم 502 «عطل من مزوّد النموذج» عن خطأ ضبط محلّي.
ACS_REPAIR_ROUNDS=1
ACS_MAX_TOKENS=32000
ACS_MAX_TOKENS_REPAIR=48000
ACS_MAX_TOKENS_PLAN=16000
ACS_MAX_TOKENS_DETAIL=24000

# ── مهلٌ صريحة: ردٌّ مصنَّف بدل انقطاع بلا جسد ──
# مهلة الخادم للطلب الواحد. اجعلها أقصر من مهلة الواجهة (900 ث) ليصل 504 بجسد JSON.
ACS_REQUEST_TIMEOUT_S=840
# مهلة نداء مزوّد النموذج نفسه.
ACS_UPSTREAM_TIMEOUT_S=600
# تراجع تصاعدي بين محاولات الأعطال العابرة وحدها (ثانية).
ACS_UPSTREAM_BACKOFF_S=2
# عدد خيوط التوليد المتزامنة داخل العملية.
ACS_WORKER_THREADS=8
# ملفّ حفظ آخر رد نموذجٍ تعذّر تحليله (مرادف قديم؛ لم يعد يُقرأ في مسار الحفظ).
ACS_RAW_DUMP=last_llm_response.txt

# ── حفظ الرد الخام: اشتراك صريح، مطفأ افتراضياً (F-13) ──
# الرد الخام مخرجُ النموذج عن وصف الزائر. لا يُحفظ على القرص إلا بطلب صريح،
# ولا يُذكر مساره في أي رد. القيمة الفارغة = مطفأ — وهو الحال في الإنتاج ما لم
# يُضبط هذا المتغيّر صراحةً.
ACS_RAW_DUMP_ENABLED=
# مجلّد الحفظ — يُنشأ بصلاحية 0700 وملفّاته 0600. فارغ = acs_raw_dumps
ACS_RAW_DUMP_DIR=
# أقصى عدد ملفّات تبقى؛ ما قبلها يُحذف. فارغ = 5
ACS_RAW_DUMP_KEEP=

# ── تسعير التليمتري (اختياري): بلا ضبط لا يظهر حقل التكلفة إطلاقاً ──
# دولار لكل مليون رمز. اتركهما فارغين ما لم تكن التسعيرة معلومة من عقد المزوّد:
# رقمٌ مُخمَّن يظهر في التليمتري كأنه فاتورة. الفراغ لا يُسقط الإقلاع.
ACS_PRICE_INPUT_PER_MTOK=
ACS_PRICE_OUTPUT_PER_MTOK=
