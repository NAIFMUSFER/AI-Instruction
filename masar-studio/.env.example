# Local development defaults. Do not commit real secrets.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
ALLOW_REGISTRATION=true
# DB_PATH=/absolute/path/to/persistent-data/masar.sqlite

# Optional server-side AI. No model identifier is guessed or silently chosen.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Optional one-time bootstrap when public registration is closed.
# Use a unique password of at least 12 characters; remove it after first startup.
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=

# local | ephemeral | persistent | operator-managed.
# Set persistent only when DB_PATH is on an operator-provisioned persistent volume.
PERSISTENCE_CLASS=local
