{
  "schema": "acs.render/1",
  "version": "1.0.0",
  "compiler_version": "acs-render/1.0.0",
  "extends": "acs.visual/1",
  "note": "presentation output derived from the canonical engineering model. A render is never engineering truth, never a certification and never a source of geometry.",
  "authority_note": "the deterministic base render is the geometry authority. An AI image is downstream of it and is always optional.",
  "pipeline": [
    "CANONICAL_ENGINEERING_MODEL",
    "DETERMINISTIC_VISUAL_SCENE",
    "CAMERA_MATERIAL_LIGHTING",
    "BASE_RENDER",
    "CONTROL_BUFFERS",
    "OPTIONAL_AI_ENHANCEMENT",
    "PRESENTATION_IMAGE"
  ],
  "reverse_write_allowed": false,
  "reverse_write_note": "there is no path from a presentation image back to the engineering model. An AI image can never become model truth.",
  "writes_to_model": false,
  "model_hash_inputs": [
    "model"
  ],
  "view_types": [
    "EXTERIOR",
    "INTERIOR",
    "DOLLHOUSE",
    "CUTAWAY",
    "ISOMETRIC",
    "TOP",
    "FLOOR_PLAN",
    "SECTION",
    "ELEVATION",
    "PANORAMA",
    "VR_PREVIEW"
  ],
  "raster_view_types": [
    "EXTERIOR",
    "INTERIOR",
    "DOLLHOUSE",
    "CUTAWAY",
    "ISOMETRIC",
    "TOP",
    "PANORAMA",
    "VR_PREVIEW"
  ],
  "vector_view_types": [
    "FLOOR_PLAN",
    "SECTION",
    "ELEVATION"
  ],
  "request_fields": [
    "request_id",
    "model_hash",
    "revision_id",
    "building_id",
    "level_id",
    "space_id",
    "view_type",
    "camera",
    "quality",
    "theme",
    "lighting",
    "ai_enhancement",
    "reference_ids"
  ],
  "request_note": "a render request is presentation state. It is validated, pinned to a model hash and a revision, and never mutates the model.",
  "qualities": [
    "LOW",
    "MEDIUM",
    "HIGH",
    "ULTRA"
  ],
  "default_quality": "HIGH",
  "quality_profile": {
    "LOW": {
      "shadow_mode": "LOW",
      "ambient_occlusion": false,
      "post": [
        "TONE_MAPPING"
      ],
      "pixel_ratio": 1.0,
      "env_quality": "PROCEDURAL",
      "max_px": 2073600
    },
    "MEDIUM": {
      "shadow_mode": "MEDIUM",
      "ambient_occlusion": false,
      "post": [
        "TONE_MAPPING",
        "ANTI_ALIASING"
      ],
      "pixel_ratio": 1.0,
      "env_quality": "PROCEDURAL",
      "max_px": 3686400
    },
    "HIGH": {
      "shadow_mode": "HIGH",
      "ambient_occlusion": true,
      "post": [
        "TONE_MAPPING",
        "ANTI_ALIASING",
        "EXPOSURE",
        "COLOR_CORRECTION"
      ],
      "pixel_ratio": 1.5,
      "env_quality": "ENVIRONMENT_MAP",
      "max_px": 8294400
    },
    "ULTRA": {
      "shadow_mode": "ULTRA",
      "ambient_occlusion": true,
      "post": [
        "TONE_MAPPING",
        "ANTI_ALIASING",
        "EXPOSURE",
        "COLOR_CORRECTION",
        "BLOOM"
      ],
      "pixel_ratio": 2.0,
      "env_quality": "ENVIRONMENT_MAP",
      "max_px": 33177600
    }
  },
